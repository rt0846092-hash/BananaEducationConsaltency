SECRET_KEY=change-this-to-a-long-random-string
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:5173

# Local MySQL (or leave out to use SQLite):
DATABASE_URL=mysql://root:password@127.0.0.1:3306/banana
# On Render, paste the Internal Database URL from your Postgres instance:
# DATABASE_URL=postgres://user:pass@host/dbname

# --- Used in emails -----------------------------------------------------
OFFICE_NAME=Banana Education
OFFICE_PHONE=01-555 1234
# The public site, for "open this student" links in emails
FRONTEND_URL=http://localhost:5173
# Extra addresses told about every new student (comma separated)
OFFICE_NOTIFY_EMAILS=

# --- Email (leave EMAIL_HOST empty to print emails to the log instead) ---
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
# Gmail: an app password, not the account password
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=Banana Education <noreply@example.com>

# --- Student documents -------------------------------------------------
# Required in production: Render's disk is wiped on every deploy.
# Amazon S3, or Cloudflare R2 / Backblaze B2 with AWS_S3_ENDPOINT_URL.
AWS_STORAGE_BUCKET_NAME=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_REGION_NAME=
AWS_S3_ENDPOINT_URL=
MAX_DOCUMENT_MB=10

# --- New students from the website --------------------------------------
# True: give each to the counsellor who handles their country and has the
# fewest open students. False: leave them for the owner to assign.
AUTO_ASSIGN=True

# --- seed_demo ------------------------------------------------------------
# With DEBUG=True the demo password is banana123. With DEBUG=False each
# account gets a random password printed once, unless you set this.
# DEMO_PASSWORD=
