# Where the Django API lives
VITE_API_URL=http://localhost:8000/api
# On Vercel/Render: VITE_API_URL=https://your-api.onrender.com/api

# The client's details, shown on every page
VITE_OFFICE_NAME=Banana Education
VITE_OFFICE_PHONE=01-555 1234
VITE_OFFICE_PHONE_TEL=+97715551234
VITE_OFFICE_EMAIL=hello@banana.demo
# Added to local numbers for WhatsApp links (Nepal 977)
VITE_DEFAULT_COUNTRY_CODE=977

# true shows demo logins (banana123) on the sign-in page and a "sample data"
# footer. Only for a laptop demo — never on a site on the internet.
VITE_DEMO_MODE=true
# true shows only the "sample data" footer. Use while fees are still invented.
VITE_SAMPLE_DATA=false

# --- Search engines -------------------------------------------------------
# The public address, used in the sitemap, robots.txt and share previews.
VITE_SITE_URL=https://banana-web-crk2.onrender.com
# From Google Search Console → "HTML tag" verification (just the content="…" part)
VITE_GOOGLE_SITE_VERIFICATION=
# Shown to Google as the business address
VITE_OFFICE_STREET=Putalisadak
VITE_OFFICE_CITY=Kathmandu
VITE_OFFICE_COUNTRY=NP
